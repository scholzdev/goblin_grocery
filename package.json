{
  "name": "goblin-grocery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app:dev": "node tools/app.mjs dev",
    "app": "node tools/app.mjs packaged",
    "app:check": "node tools/electron-check.mjs",
    "lab": "node tools/app.mjs dev --lab",
    "lab:app": "node tools/app.mjs packaged --lab",
    "sims": "vite --open /?sim=example",
    "sims:test": "vitest run tests/sims",
    "shot": "node tools/verify-shot.mjs",
    "buildlab": "node tools/buildlab.mjs",
    "assets": "node tools/gen-assets.mjs && node tools/gen-audio.mjs",
    "icon": "node tools/gen-icon.mjs",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "dist:win": "npm run build && electron-builder --win dir --x64",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "release": "npm run build && electron-builder --mac zip --arm64 --x64 --publish never && electron-builder --win zip --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/luckiest-guy": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.16.1",
    "phaser": "3.90.0",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "main": "electron/main.cjs",
  "description": "Goblin Grocery: a shopping-cart roguelite.",
  "author": "Goblin Grocery",
  "build": {
    "appId": "com.goblingrocery.game",
    "productName": "Goblin Grocery",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}
